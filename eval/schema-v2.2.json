{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SHIELD AI/RAG v2.2 Eval Item",
  "type": "object",
  "required": [
    "id",
    "domain",
    "query",
    "expected_chunk_ids",
    "expected_law_refs",
    "failure_type",
    "source",
    "reviewer"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^V22-Q[0-9]{3}$" },
    "domain": { "type": "string", "minLength": 1 },
    "query": { "type": "string", "minLength": 5 },
    "expected_chunk_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expected_law_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lawId", "articleNo"],
        "properties": {
          "lawId": { "type": "string" },
          "articleNo": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "failure_type": { "type": "string" },
    "source": { "type": "string" },
    "reviewer": { "type": "string" }
  },
  "additionalProperties": false
}
